{
  "builds": [
    {
      "src": "sms_prj/wsgi.py",
      "use": "@vercel/python",
      "config":{
        "buildCommand":"bash build.sh"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "sms_prj/wsgi.py"
    }
  ]
}

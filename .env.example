# Django Settings
SECRET_KEY='your-secret-key-here'  # Change this to a secure value in production
DEBUG='True'  # Change to 'False' in production
ALLOWED_HOSTS='*'  # Change to specific hosts in production

# Database Configuration
# Set USE_SUPABASE=True to use Supabase PostgreSQL
# Set USE_SUPABASE=False to use SQLite (default for local development)
USE_SUPABASE='True  or False'  # Change to 'True' or 'False' #as needed

# Supabase PostgreSQL Connection Details
# Only required if USE_SUPABASE=True
HOST='your-database-host-here'
PORT='your-database-port-here'
DB_USER='your-database-user-here'
PASSWORD='your-database-password-here'
DB_NAME='your-database-name-here'

# Supabase Client Configuration (for direct API calls)
# Get these from your Supabase project settings
SUPABASE_URL='your-supabase-url-here'
SUPABASE_KEY='your-supabase-key-here'

AWS_ACCESS_KEY_ID='your-aws-access-key-id-here'
AWS_SECRET_ACCESS_KEY='your-aws-secret-access-key-here'
AWS_STORAGE_BUCKET_NAME='your-aws-storage-bucket-name-here'
AWS_S3_REGION_NAME='your-aws-s3-region-name-here'
AWS_S3_ENDPOINT_URL='your-aws-s3-endpoint-url-here'
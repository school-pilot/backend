# Django Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration
# Set USE_SUPABASE=True to use Supabase PostgreSQL
# Set USE_SUPABASE=False to use SQLite (default for local development)
USE_SUPABASE=False

# Supabase PostgreSQL Connection Details
# Only required if USE_SUPABASE=True
HOST=db.your-project.supabase.co
PORT=5432
DB_USER=postgres
PASSWORD=your-supabase-password
DB_NAME=postgres

# Supabase Client Configuration (for direct API calls)
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-public-key
